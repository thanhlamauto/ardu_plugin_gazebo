Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Vehicle pose1
        - /3D LiDAR1
        - /RGB Camera1
        - /Depth Camera1
    Tree Height: 620
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.35
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 120; 120; 125
      Enabled: true
      Name: Local Grid
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Description File: ""
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Name: Vehicle model
      TF Prefix: ""
      Update Interval: 0
      Visual Enabled: true
    - Angle Tolerance: 0.1
      Class: rviz_default_plugins/Odometry
      Enabled: true
      Keep: 500
      Name: Vehicle odometry
      Position Tolerance: 0.1
      Shape:
        Alpha: 1
        Axes Length: 0.7
        Axes Radius: 0.05
        Color: 255; 25; 0
        Head Length: 0.22
        Head Radius: 0.08
        Shaft Length: 0.55
        Shaft Radius: 0.035
        Value: Arrow
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /iris/odometry
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.5
      Name: TF tree
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 239; 96; 40
      Color Transformer: AxisColor
      Decay Time: 0.8
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: 3D LiDAR
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.025
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /sensor_suite/lidar/points
      Use Fixed Frame: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: RGB Camera
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /sensor_suite/rgb
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 15
      Median window: 5
      Min Value: 0.1
      Name: Depth Camera
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /sensor_suite/depth
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Numeric sensor status
      Namespaces:
        imu_acceleration: true
        magnetic_field: true
        sensor_status: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /sensor_suite/status_markers
  Enabled: true
  Global Options:
    Background Color: 30; 32; 36
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 24
      Focal Point:
        X: 0
        Y: 0
        Z: 1
      Name: Vehicle and sensor overview
      Near Clip Distance: 0.01
      Pitch: 0.55
      Target Frame: odom
      Yaw: 3.6
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1500
  X: 40
  Y: 40
