Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /3D LiDAR1
        - /RGB Camera1
        - /Depth Camera1
    Tree Height: 620
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.35
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 120; 120; 125
      Enabled: true
      Name: Local Grid
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: sensor_suite_link
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 239; 96; 40
      Color Transformer: AxisColor
      Decay Time: 0.8
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: 3D LiDAR
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.025
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /sensor_suite/lidar/points
      Use Fixed Frame: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: RGB Camera
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /sensor_suite/rgb
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 15
      Median window: 5
      Min Value: 0.1
      Name: Depth Camera
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /sensor_suite/depth
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Numeric sensor status
      Namespaces:
        imu_acceleration: true
        magnetic_field: true
        sensor_status: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /sensor_suite/status_markers
  Enabled: true
  Global Options:
    Background Color: 30; 32; 36
    Fixed Frame: sensor_suite_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 11
      Focal Point:
        X: 1.5
        Y: 0
        Z: 0.5
      Name: Sensor overview
      Near Clip Distance: 0.01
      Pitch: 0.55
      Target Frame: sensor_suite_link
      Yaw: 3.6
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1500
  X: 40
  Y: 40
