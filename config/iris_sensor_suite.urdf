<?xml version="1.0"?>
<robot name="iris_sensor_suite">
  <material name="body_dark">
    <color rgba="0.10 0.12 0.15 1"/>
  </material>
  <material name="arm_blue">
    <color rgba="0.05 0.30 0.85 1"/>
  </material>
  <material name="sensor_orange">
    <color rgba="0.95 0.35 0.08 1"/>
  </material>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.22 0.16 0.08"/>
      </geometry>
      <material name="body_dark"/>
    </visual>
  </link>

  <link name="front_arm">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0.785398"/>
      <geometry>
        <box size="0.55 0.035 0.025"/>
      </geometry>
      <material name="arm_blue"/>
    </visual>
  </link>
  <joint name="front_arm_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_arm"/>
  </joint>

  <link name="rear_arm">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 -0.785398"/>
      <geometry>
        <box size="0.55 0.035 0.025"/>
      </geometry>
      <material name="arm_blue"/>
    </visual>
  </link>
  <joint name="rear_arm_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_arm"/>
  </joint>

  <link name="rotor_0">
    <visual>
      <geometry><cylinder radius="0.11" length="0.008"/></geometry>
      <material name="body_dark"/>
    </visual>
  </link>
  <joint name="rotor_0_joint" type="fixed">
    <origin xyz="0.195 0.195 0.025"/>
    <parent link="base_link"/>
    <child link="rotor_0"/>
  </joint>

  <link name="rotor_1">
    <visual>
      <geometry><cylinder radius="0.11" length="0.008"/></geometry>
      <material name="body_dark"/>
    </visual>
  </link>
  <joint name="rotor_1_joint" type="fixed">
    <origin xyz="-0.195 0.195 0.025"/>
    <parent link="base_link"/>
    <child link="rotor_1"/>
  </joint>

  <link name="rotor_2">
    <visual>
      <geometry><cylinder radius="0.11" length="0.008"/></geometry>
      <material name="body_dark"/>
    </visual>
  </link>
  <joint name="rotor_2_joint" type="fixed">
    <origin xyz="-0.195 -0.195 0.025"/>
    <parent link="base_link"/>
    <child link="rotor_2"/>
  </joint>

  <link name="rotor_3">
    <visual>
      <geometry><cylinder radius="0.11" length="0.008"/></geometry>
      <material name="body_dark"/>
    </visual>
  </link>
  <joint name="rotor_3_joint" type="fixed">
    <origin xyz="0.195 -0.195 0.025"/>
    <parent link="base_link"/>
    <child link="rotor_3"/>
  </joint>

  <link name="sensor_suite_link">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.16 0.10 0.06"/></geometry>
      <material name="sensor_orange"/>
    </visual>
  </link>
  <joint name="sensor_suite_joint" type="fixed">
    <origin xyz="0.08 0 0.16"/>
    <parent link="base_link"/>
    <child link="sensor_suite_link"/>
  </joint>
</robot>
