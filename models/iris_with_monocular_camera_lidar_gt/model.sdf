<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <model name="iris_with_monocular_camera_lidar_gt">
    <include>
      <uri>model://iris_with_gimbal_monocular</uri>
    <name>iris_with_gimbal</name></include>
    <link name="sensor_suite_link">
      <pose relative_to="iris_with_gimbal::iris_with_standoffs::base_link">
        0.08 0 0.16 0 0 0
      </pose>
      <inertial>
        <mass>0.12</mass>
        <inertia>
          <ixx>0.0008</ixx>
          <iyy>0.0008</iyy>
          <izz>0.0008</izz>
        </inertia>
      </inertial>
      <visual name="sensor_pod">
        <geometry>
          <box>
            <size>0.16 0.10 0.06</size>
          </box>
        </geometry>
        <material>
          <ambient>0.06 0.08 0.10 1</ambient>
          <diffuse>0.12 0.16 0.20 1</diffuse>
        </material>
      </visual>
      <sensor name="rgb_camera" type="camera">
        <gz_frame_id>sensor_suite_link</gz_frame_id>
        <pose>0.09 0 0 0 0 0</pose>
        <topic>/sensor_suite/rgb</topic>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>360</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.08</near>
            <far>40</far>
          </clip>
        </camera>
      </sensor>
      <!-- Evaluation-only sensor. No perception or planner process subscribes to this topic. -->
      <sensor name="lidar_ground_truth" type="gpu_lidar">
        <gz_frame_id>sensor_suite_link</gz_frame_id>
        <pose>0.09 0 0 0 0 0</pose>
        <topic>/benchmark/lidar_ground_truth</topic>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>640</samples><resolution>1</resolution>
              <min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle>
            </horizontal>
            <vertical>
              <samples>32</samples><resolution>1</resolution>
              <min_angle>-0.52359878</min_angle><max_angle>0.52359878</max_angle>
            </vertical>
          </scan>
          <range><min>0.15</min><max>30</max><resolution>0.02</resolution></range>
        </lidar>
      </sensor>
      <sensor name="imu_viz" type="imu">
        <gz_frame_id>sensor_suite_link</gz_frame_id>
        <topic>/sensor_suite/imu</topic>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <imu>
          <orientation_reference_frame>
            <localization>ENU</localization>
          </orientation_reference_frame>
          <!-- 100 Hz: sample stddev = continuous density * sqrt(100 Hz). -->
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.0016968</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.0016968</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.0016968</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="magnetometer" type="magnetometer">
        <gz_frame_id>sensor_suite_link</gz_frame_id>
        <topic>/sensor_suite/magnetic_field</topic>
        <always_on>true</always_on>
        <update_rate>20</update_rate>
      </sensor>
      <sensor name="air_pressure" type="air_pressure">
        <gz_frame_id>sensor_suite_link</gz_frame_id>
        <topic>/sensor_suite/air_pressure</topic>
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <air_pressure>
          <reference_altitude>0</reference_altitude>
        </air_pressure>
      </sensor>
      <sensor name="navsat" type="navsat">
        <gz_frame_id>sensor_suite_link</gz_frame_id>
        <topic>/sensor_suite/navsat</topic>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
      </sensor>
    </link>
    <joint name="sensor_suite_joint" type="fixed">
      <parent>iris_with_gimbal::iris_with_standoffs::base_link</parent>
      <child>sensor_suite_link</child>
    </joint>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>30</odom_publish_frequency>
      <odom_topic>/iris/odometry</odom_topic>
      <tf_topic>/tf</tf_topic>
    </plugin>
  </model>
</sdf>
