    <include><name>obstacle_0</name><uri>model://monocular_textured_box</uri><pose>8 4 3 0 0 0</pose></include><include><name>obstacle_1</name><uri>model://monocular_textured_box</uri><pose>30 6 3 0 0 0</pose></include><include><name>obstacle_2</name><uri>model://monocular_textured_box</uri><pose>50 6 3 0 0 0</pose></include><include><name>obstacle_3</name><uri>model://monocular_textured_box</uri><pose>70 6 3 0 0 0</pose></include></world>
